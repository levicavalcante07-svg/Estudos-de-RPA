# Copie este arquivo para .env (na mesma pasta) e preencha com os seus dados.
# O .env está no .gitignore e NUNCA deve ser commitado.

# Desafios 04 e 05 (LinkedIn)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Desafio FlightRadar (login com conta Google)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Opcional: caminho do executável do Tesseract, caso ele não esteja no PATH
# Ex.: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Opcional: 1 para rodar os navegadores sem abrir janela (Selenium e Playwright)
HEADLESS=0
